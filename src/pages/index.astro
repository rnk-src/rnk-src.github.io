---
import Base from '../layouts/Base.astro';
import Penguin from '../components/Penguin.astro';
import Hills from '../components/Hills.astro';
import Moon from '../components/Moon.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Rounak Rai | Projects"
  description="Robotics, embedded and software projects by Rounak Rai, an ECE student at UT Austin."
>
  <header class="hero">
    <Moon class="hero-moon" size={8} />
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>Rounak Rai</h1>
        <p class="role">ECE at UT Austin. Robotics and embedded software.</p>
        <ContactLinks label="Contact" class="hero-contact" />
      </div>
    </div>
    <Hills>
      <Penguin class="hero-penguin" size={10} />
    </Hills>
  </header>
  <main id="projects" class="wrap">
    <h2>Projects</h2>
    <div class="showcases">
      {projects.map((p, i) => (
        <ProjectShowcase project={p} index={i} />
      ))}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: min(78dvh, 720px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .hero-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 0;
  }
  .hero-copy {
    padding-bottom: clamp(48px, 10vw, 96px);
  }
  h1 {
    font-size: clamp(2.25rem, 8vw, 4rem);
    letter-spacing: -0.02em;
  }
  .role {
    margin-top: 16px;
    max-width: 32ch;
    color: var(--ink-muted);
    font-size: 1.25rem;
  }
  main {
    position: relative;
    z-index: 1;
    padding-top: clamp(40px, 6vw, 72px);
  }
  h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 32px;
  }
  :global(.hero-contact) {
    margin-top: 28px;
  }
  :global(.hero-moon) {
    position: absolute;
    top: clamp(32px, 7vw, 88px);
    right: max(var(--gutter), calc((100% - var(--page-max)) / 2));
  }
  @media (max-width: 560px) {
    :global(.hero-moon) {
      width: 60px;
      height: 60px;
    }
    :global(.hero-penguin) {
      width: 80px;
      height: auto;
    }
  }
</style>
