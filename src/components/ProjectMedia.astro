---
import { Image } from 'astro:assets';
import Penguin from './Penguin.astro';
import type { ImageMetadata } from 'astro';

interface Shot {
  src: ImageMetadata;
  alt: string;
  label?: string;
}
interface Props {
  title: string;
  youtube?: string;
  image?: Shot & { second?: Shot; mode?: 'pair' | 'toggle' };
}
const { title, youtube, image } = Astro.props;
const toggle = image?.mode === 'toggle' && !!image.second;
const shots = image ? [image, ...(image.second ? [image.second] : [])] : [];
---

<div class="media" data-impeccable-ignore="cramped-padding">
  {youtube ? (
    <a
      class="video"
      href={`https://www.youtube.com/watch?v=${youtube}`}
      target="_blank"
      rel="noopener"
      data-youtube={youtube}
      data-title={`${title} demo video`}
    >
      <span class="pals" aria-hidden="true">
        <span class="pal left">
          <svg class="huh" viewBox="0 0 5 7" shape-rendering="crispEdges">
            <path d="M1 0h3v1h1v2h-1v1h-1v1h-1v-1h1v-1h1v-2h-3zM2 6h1v1h-1z" />
          </svg>
          <Penguin size={5} />
        </span>
        <span class="play" />
        <span class="pal right">
          <svg class="huh" viewBox="0 0 5 7" shape-rendering="crispEdges">
            <path d="M1 0h3v1h1v2h-1v1h-1v1h-1v-1h1v-1h1v-2h-3zM2 6h1v1h-1z" />
          </svg>
          <Penguin size={5} />
        </span>
      </span>
      <span class="label">Play the {title} demo</span>
    </a>
  ) : shots.length ? (
    <div
      class:list={['shots', { pair: shots.length > 1 && !toggle, toggle }]}
      data-toggle={toggle ? '' : undefined}
    >
      {shots.map((shot, i) => (
        <figure hidden={toggle && i > 0 ? true : undefined}>
          <Image
            src={shot.src}
            alt={shot.alt}
            widths={[480, 720, 960, 1280]}
            sizes="(max-width: 1000px) 90vw, 700px"
            format="webp"
            quality={80}
          />
          {shot.label && !toggle && <figcaption>{shot.label}</figcaption>}
        </figure>
      ))}
      {toggle && (
        <div class="tabs">
          {shots.map((shot, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'}>
              {shot.label ?? `View ${i + 1}`}
            </button>
          ))}
        </div>
      )}
    </div>
  ) : (
    <div class="placeholder">
      <p>Demo coming soon</p>
    </div>
  )}
</div>

<script>
  // Toggle media: show one image at a time. Without JavaScript the first image shows.
  document.querySelectorAll<HTMLElement>('[data-toggle]').forEach((box) => {
    const figures = box.querySelectorAll('figure');
    const buttons = box.querySelectorAll('button');
    buttons.forEach((button, i) => {
      button.addEventListener('click', () => {
        figures.forEach((figure, j) => (figure.hidden = i !== j));
        buttons.forEach((b, j) =>
          b.setAttribute('aria-pressed', String(i === j)),
        );
      });
    });
  });
</script>

<script>
  // Load the YouTube player only after a click. Without JavaScript the link opens YouTube.
  document
    .querySelectorAll<HTMLAnchorElement>('a[data-youtube]')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtube}?autoplay=1&rel=0`;
        iframe.title = link.dataset.title ?? 'Project demo video';
        iframe.allow =
          'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.className = 'player';
        link.replaceWith(iframe);
        iframe.focus();
      });
    });
</script>

<style>
  .media {
    --n: 4px;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: var(--line);
    padding: 2px;
    clip-path: polygon(
      0 var(--n),
      var(--n) var(--n),
      var(--n) 0,
      calc(100% - var(--n)) 0,
      calc(100% - var(--n)) var(--n),
      100% var(--n),
      100% calc(100% - var(--n)),
      calc(100% - var(--n)) calc(100% - var(--n)),
      calc(100% - var(--n)) 100%,
      var(--n) 100%,
      var(--n) calc(100% - var(--n)),
      0 calc(100% - var(--n))
    );
  }
  .media > :global(*) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .shots {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    background: var(--line);
  }
  .shots.pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .shots figure {
    position: relative;
    margin: 0;
    min-height: 0;
    background: var(--night-1);
  }
  .shots :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shots.toggle {
    position: relative;
  }
  .shots figure[hidden] {
    display: none;
  }
  .tabs {
    position: absolute;
    inset-block-end: 6px;
    inset-inline-end: 6px;
    display: flex;
    gap: 2px;
  }
  .tabs button {
    padding: 4px 10px;
    border: 0;
    background: var(--night-1);
    color: var(--ink-faint);
    font: inherit;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .tabs button[aria-pressed='true'] {
    color: var(--accent-strong);
  }
  .tabs button:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }
  .shots figcaption {
    position: absolute;
    inset-block-end: 6px;
    inset-inline-start: 6px;
    padding: 2px 8px;
    background: var(--night-1);
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .placeholder,
  .video {
    display: grid;
    place-items: center;
    background: var(--night-1);
    color: var(--ink-faint);
  }
  .placeholder p {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .video {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    background: var(--night-0);
  }
  .video:hover {
    background: var(--night-1);
  }
  /* Two chicks puzzle over the play button. Each leans in and tilts its head, and a
     question mark floats above. The sprites are decorative. */
  .pals {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 5%, 40px);
    width: 100%;
    margin-block-end: 20px;
  }
  .pal {
    position: relative;
    flex: 0 0 clamp(56px, 18%, 88px);
  }
  .pal :global(svg.penguin) {
    width: 100%;
    height: auto;
    transform-origin: 50% 100%;
    animation: ponder 4.8s steps(1) infinite;
  }
  .pal.right :global(svg.penguin) {
    animation-name: ponder-right;
    animation-delay: -1.7s;
  }
  .huh {
    position: absolute;
    width: 20%;
    inset-block-start: -22%;
    fill: var(--accent);
  }
  .left .huh {
    inset-inline-start: 4%;
  }
  .right .huh {
    inset-inline-end: 4%;
  }
  @keyframes ponder {
    0%,
    45% {
      transform: rotate(8deg);
    }
    50%,
    100% {
      transform: rotate(16deg);
    }
  }
  @keyframes ponder-right {
    0%,
    45% {
      transform: rotate(-16deg);
    }
    50%,
    100% {
      transform: rotate(-8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pal :global(svg.penguin) {
      animation: none;
    }
    .pal.left :global(svg.penguin) {
      transform: rotate(8deg);
    }
    .pal.right :global(svg.penguin) {
      transform: rotate(-8deg);
    }
  }
  .play {
    width: 0;
    height: 0;
    border-block: 16px solid transparent;
    border-inline-start: 28px solid var(--accent);
  }
  .label {
    position: absolute;
    inset-inline: 16px;
    bottom: 12px;
    text-align: center;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--accent-strong);
  }
</style>
