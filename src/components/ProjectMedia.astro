---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Shot {
  src: ImageMetadata;
  alt: string;
  label?: string;
  after?: { src: ImageMetadata; alt: string };
}
interface Props {
  title: string;
  youtube?: string;
  image?: Shot & { second?: Shot; mode?: 'pair' | 'toggle' };
}
const { title, youtube, image } = Astro.props;
const toggle = image?.mode === 'toggle' && !!image.second;
const shots = image ? [image, ...(image.second ? [image.second] : [])] : [];
const compare = shots.some((s) => s.after);
---

<div
  class:list={['media', { compare }]}
  data-impeccable-ignore="cramped-padding"
>
  {youtube ? (
    <a
      class="video"
      href={`https://www.youtube.com/watch?v=${youtube}`}
      target="_blank"
      rel="noopener"
      data-youtube={youtube}
      data-title={`${title} demo video`}
    >
      <img
        class="thumb"
        src={`https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span class="play" aria-hidden="true" />
      <span class="label">Play the {title} demo</span>
    </a>
  ) : shots.length ? (
    <div
      class:list={['shots', { pair: shots.length > 1 && !toggle, toggle }]}
      data-toggle={toggle ? '' : undefined}
    >
      {shots.map((shot, i) => (
        <figure hidden={toggle && i > 0 ? true : undefined}>
          {shot.after ? (
            <div class="ba" style="--pos: 50%" data-compare>
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[480, 720, 960]}
                sizes="(max-width: 1000px) 90vw, 700px"
                format="webp"
                quality={80}
              />
              <Image
                class="after"
                src={shot.after.src}
                alt={shot.after.alt}
                widths={[480, 720, 960]}
                sizes="(max-width: 1000px) 90vw, 700px"
                format="webp"
                quality={80}
              />
              <span class="layer before-layer" aria-hidden="true">
                <span class="tag">Before</span>
              </span>
              <span class="layer after-layer" aria-hidden="true">
                <span class="tag">After</span>
              </span>
              <span class="bar" aria-hidden="true" />
              <span class="grip" aria-hidden="true" />
              <input
                type="range"
                min="0"
                max="100"
                step="1"
                value="50"
                aria-label={`Compare before and after${shot.label ? `: ${shot.label}` : ''}`}
              />
            </div>
          ) : shot.src.format === 'gif' ? (
            <img
              src={shot.src.src}
              alt={shot.alt}
              width={shot.src.width}
              height={shot.src.height}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={[480, 720, 960, 1280]}
              sizes="(max-width: 1000px) 90vw, 700px"
              format="webp"
              quality={80}
            />
          )}
          {shot.label && !toggle && <figcaption>{shot.label}</figcaption>}
        </figure>
      ))}
      {toggle && (
        <div class="tabs">
          {shots.map((shot, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'}>
              {shot.label ?? `View ${i + 1}`}
            </button>
          ))}
        </div>
      )}
    </div>
  ) : (
    <div class="placeholder">
      <p>Demo coming soon</p>
    </div>
  )}
</div>

<script>
  // Toggle media: show one image at a time. Without JavaScript the first image shows.
  document.querySelectorAll<HTMLElement>('[data-toggle]').forEach((box) => {
    const figures = box.querySelectorAll('figure');
    const buttons = box.querySelectorAll('button');
    buttons.forEach((button, i) => {
      button.addEventListener('click', () => {
        figures.forEach((figure, j) => (figure.hidden = i !== j));
        buttons.forEach((b, j) =>
          b.setAttribute('aria-pressed', String(i === j)),
        );
      });
    });
  });
</script>

<script>
  // Before/after sliders. Each one eases between the two edges, slow at the ends and fast in
  // the middle, and rests at each edge so the change can be read. Touching it pauses the
  // sweep for a few seconds. Reduced motion keeps it still at the middle.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SWEEP_MS = 3400;
  const EDGE_HOLD_MS = 2200;
  const IDLE_MS = 4000;
  const ease = (t: number) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((box) => {
    const input = box.querySelector('input')!;
    let pos = 50;
    const set = (v: number) => {
      pos = v;
      input.value = String(v);
      box.style.setProperty('--pos', `${v}%`);
    };
    input.addEventListener('input', () => set(Number(input.value)));
    if (still) return;

    let visible = false;
    let restart = true;
    new IntersectionObserver(([e]) => {
      // A tab switch hides one slider and shows the other. Start the shown one fresh.
      if (e.isIntersecting && !visible) restart = true;
      visible = e.isIntersecting;
    }).observe(box);

    let from = pos;
    let to = 0;
    let start = performance.now();
    let duration = SWEEP_MS * (Math.abs(to - from) / 100);
    let holdUntil = 0;
    let rest = 0;
    const retarget = (now: number, target: number) => {
      from = pos;
      to = target;
      start = now;
      duration = Math.max(600, SWEEP_MS * (Math.abs(to - from) / 100));
    };
    const touch = () => (rest = performance.now() + IDLE_MS);
    ['pointerdown', 'keydown', 'input'].forEach((t) =>
      input.addEventListener(t, touch),
    );

    const tick = (now: number) => {
      requestAnimationFrame(tick);
      if (!visible || document.hidden) {
        // Do not burn the schedule while off screen.
        start += 16;
        return;
      }
      if (restart) {
        restart = false;
        set(50);
        holdUntil = 0;
        rest = 0;
        retarget(now, 0);
      }
      if (now < rest) {
        retarget(now, to);
        return;
      }
      if (now < holdUntil) return;
      const t = Math.min(1, (now - start) / duration);
      set(Math.round((from + (to - from) * ease(t)) * 10) / 10);
      if (t >= 1) {
        holdUntil = now + EDGE_HOLD_MS;
        retarget(holdUntil, to === 0 ? 100 : 0);
      }
    };
    requestAnimationFrame(tick);
  });
</script>

<script>
  // Load the YouTube player only after a click. Without JavaScript the link opens YouTube.
  document
    .querySelectorAll<HTMLAnchorElement>('a[data-youtube]')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtube}?autoplay=1&rel=0`;
        iframe.title = link.dataset.title ?? 'Project demo video';
        iframe.allow =
          'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.className = 'player';
        link.replaceWith(iframe);
        iframe.focus();
      });
    });
</script>

<style>
  .media {
    --n: 4px;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: var(--line);
    padding: 2px;
    clip-path: polygon(
      0 var(--n),
      var(--n) var(--n),
      var(--n) 0,
      calc(100% - var(--n)) 0,
      calc(100% - var(--n)) var(--n),
      100% var(--n),
      100% calc(100% - var(--n)),
      calc(100% - var(--n)) calc(100% - var(--n)),
      calc(100% - var(--n)) 100%,
      var(--n) 100%,
      var(--n) calc(100% - var(--n)),
      0 calc(100% - var(--n))
    );
  }
  .media > :global(*) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .shots {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    background: var(--line);
  }
  .shots.pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .media.compare {
    aspect-ratio: 4 / 3;
  }
  .ba {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    touch-action: pan-y;
  }
  .ba :global(img) {
    position: absolute;
    inset: 0;
    object-position: 50% 0;
  }
  .ba :global(img.after) {
    clip-path: inset(0 0 0 var(--pos));
  }
  /* The bar and grip are clamped so they stay fully inside the frame at both edges. */
  .bar {
    position: absolute;
    inset-block: 0;
    inset-inline-start: clamp(2px, var(--pos), calc(100% - 2px));
    width: 4px;
    margin-inline-start: -2px;
    background: var(--accent-strong);
  }
  .grip {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: clamp(14px, var(--pos), calc(100% - 14px));
    width: 20px;
    height: 32px;
    transform: translate(-50%, -50%);
    background: var(--accent);
    border: 4px solid var(--night-0);
  }
  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Each label is clipped by the slider, so it vanishes with the side it belongs to. */
  .before-layer {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .after-layer {
    clip-path: inset(0 0 0 var(--pos));
  }
  .tag {
    position: absolute;
    inset-block-start: 8px;
    padding: 2px 8px;
    background: var(--night-1);
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .before-layer .tag {
    inset-inline-start: 8px;
  }
  .after-layer .tag {
    inset-inline-end: 8px;
  }
  .ba input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ba:has(input:focus-visible) {
    outline: 2px solid var(--accent-strong);
    outline-offset: -4px;
  }
  .shots figure {
    position: relative;
    margin: 0;
    min-height: 0;
    background: var(--night-1);
  }
  .shots :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shots.toggle {
    position: relative;
  }
  .shots figure[hidden] {
    display: none;
  }
  .tabs {
    position: absolute;
    inset-block-end: 6px;
    inset-inline-end: 6px;
    display: flex;
    gap: 2px;
  }
  .tabs button {
    padding: 4px 10px;
    border: 0;
    background: var(--night-1);
    color: var(--ink-faint);
    font: inherit;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .tabs button[aria-pressed='true'] {
    color: var(--accent-strong);
  }
  .tabs button:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 2px;
  }
  .shots figcaption {
    position: absolute;
    inset-block-end: 6px;
    inset-inline-start: 6px;
    padding: 2px 8px;
    background: var(--night-1);
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .placeholder,
  .video {
    display: grid;
    place-items: center;
    background: var(--night-1);
    color: var(--ink-faint);
  }
  .placeholder p {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .video {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    background: var(--night-0);
  }
  .video:hover {
    background: var(--night-1);
  }
  /* YouTube pads portrait and odd-ratio videos with pure black. Contain keeps the whole
     picture visible, and lighten turns that black into the frame's own background. */
  .thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: lighten;
  }
  /* The play button sits on a dark disc so it reads over any thumbnail. */
  .play {
    position: relative;
    width: 72px;
    height: 72px;
    background: color-mix(in srgb, var(--night-0) 80%, transparent);
    display: grid;
    place-items: center;
  }
  .play::before {
    content: '';
    margin-inline-start: 6px;
    border-block: 14px solid transparent;
    border-inline-start: 24px solid var(--accent);
  }
  .label {
    position: absolute;
    inset-inline: 16px;
    bottom: 12px;
    text-align: center;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--accent-strong);
    text-shadow: 0 1px 4px var(--night-0);
  }
</style>
