---
interface Props {
  title: string;
  youtube?: string;
}
const { title, youtube } = Astro.props;
---

<div class="media">
  {youtube ? (
    <a
      class="video"
      href={`https://www.youtube.com/watch?v=${youtube}`}
      target="_blank"
      rel="noopener"
      data-youtube={youtube}
      data-title={`${title} demo video`}
    >
      <span class="play" aria-hidden="true" />
      <span class="label">Play the {title} demo</span>
    </a>
  ) : (
    <div class="placeholder">
      <p>Demo coming soon</p>
    </div>
  )}
</div>

<script>
  // Load the YouTube player only after a click. Without JavaScript the link opens YouTube.
  document
    .querySelectorAll<HTMLAnchorElement>('a[data-youtube]')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtube}?autoplay=1&rel=0`;
        iframe.title = link.dataset.title ?? 'Project demo video';
        iframe.allow =
          'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.className = 'player';
        link.replaceWith(iframe);
        iframe.focus();
      });
    });
</script>

<style>
  .media {
    --n: 4px;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: var(--line);
    padding: 2px;
    clip-path: polygon(
      0 var(--n),
      var(--n) var(--n),
      var(--n) 0,
      calc(100% - var(--n)) 0,
      calc(100% - var(--n)) var(--n),
      100% var(--n),
      100% calc(100% - var(--n)),
      calc(100% - var(--n)) calc(100% - var(--n)),
      calc(100% - var(--n)) 100%,
      var(--n) 100%,
      var(--n) calc(100% - var(--n)),
      0 calc(100% - var(--n))
    );
  }
  .media > :global(*) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .placeholder,
  .video {
    display: grid;
    place-items: center;
    background: var(--night-1);
    color: var(--ink-faint);
  }
  .placeholder p {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .video {
    position: relative;
    color: var(--ink);
    text-decoration: none;
  }
  .video:hover {
    background: var(--night-2);
  }
  .play {
    width: 0;
    height: 0;
    border-block: 16px solid transparent;
    border-inline-start: 28px solid var(--accent);
  }
  .label {
    position: absolute;
    inset-inline: 16px;
    bottom: 12px;
    text-align: center;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--accent-strong);
  }
</style>
