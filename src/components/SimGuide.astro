---
// A chick that pops up from behind the simulation when it starts, says how to use it,
// waves bye and ducks back down. Once per page. Decorative: the simulation shows the
// same hint itself, so the chick and its bubble are hidden from screen readers.
import Penguin from './Penguin.astro';
---

<template id="sim-guide">
  <div class="chick">
    <Penguin size={7} happy wave />
  </div>
  <p class="bubble">
    Tap My hand, then move over the blue mortar. Hold to press!
  </p>
</template>

<script>
  // ProjectMedia sends this event when the simulation reaches its running state.
  const FIRST_MS = 900; // let the simulation draw its first frame
  const POP_MS = 450; // the chick climbs out in five steps
  const READ_MS = 6500; // time to read the bubble
  const WAVE_MS = 2000;

  const template = document.querySelector<HTMLTemplateElement>('#sim-guide');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let shown = false;

  function show(side: HTMLElement) {
    if (!template || !side.isConnected) return;
    const guide = document.createElement('div');
    guide.className = 'guide';
    guide.setAttribute('aria-hidden', 'true');
    guide.append(template.content.cloneNode(true));
    side.append(guide);
    const chick = guide.querySelector('svg')!;
    const bubble = guide.querySelector('.bubble')!;

    requestAnimationFrame(() =>
      requestAnimationFrame(() => guide.classList.add('out')),
    );
    setTimeout(() => bubble.classList.add('on'), POP_MS);
    setTimeout(() => {
      chick.classList.add('waving');
      bubble.textContent = 'Bye!';
    }, POP_MS + READ_MS);
    setTimeout(() => guide.classList.remove('out'), POP_MS + READ_MS + WAVE_MS);
    setTimeout(() => guide.remove(), 2 * POP_MS + READ_MS + WAVE_MS + 100);
  }

  document.addEventListener('sim-running', (event) => {
    if (shown || reduced) return;
    const side = (event.target as Element).closest<HTMLElement>('.media-side');
    if (!side) return;
    shown = true;
    setTimeout(() => show(side), FIRST_MS);
  });
</script>

<style is:global>
  /* The guide is a zero-height strip on the top edge of the media. The chick rises from
     behind the frame like the peeking chick, but far enough to show a flipper. */
  .guide {
    --s: 7px; /* CSS pixels per sprite pixel */
    --rows: 14; /* sprite rows that show above the frame */
    position: absolute;
    z-index: -1;
    top: 0;
    left: 16px;
    height: 0;
    pointer-events: none;
  }
  .guide .chick {
    position: absolute;
    top: 0;
    left: 0;
    transition: top 0.45s steps(5);
  }
  .guide .chick svg {
    width: calc(16 * var(--s));
    height: calc(18 * var(--s));
  }
  /* Show the head, body and flippers: 14 of the 18 sprite rows. */
  .guide.out .chick {
    top: calc(var(--s) * var(--rows) * -1);
  }
  .guide .bubble {
    position: absolute;
    left: calc(16 * var(--s) + 20px);
    bottom: 12px;
    width: max-content;
    max-width: min(280px, calc(100vw - 16 * var(--s) - 96px));
    margin: 0;
    padding: 8px 12px;
    color: var(--ink);
    background: var(--night-2);
    border: 2px solid var(--line-strong);
    font: 400 13px/1.4 var(--font-body);
    opacity: 0;
    transition: opacity 0.3s steps(3);
  }
  .guide .bubble.on {
    opacity: 1;
  }
  .guide .bubble::before {
    content: '';
    position: absolute;
    left: -7px;
    bottom: 10px;
    width: 10px;
    height: 10px;
    background: var(--night-2);
    border-left: 2px solid var(--line-strong);
    border-bottom: 2px solid var(--line-strong);
    transform: rotate(45deg);
  }
  /* Stacked layout: only 24px of space sits above the frame, so the chick is smaller and
     shows less of itself. It would otherwise cover the link in the card above. */
  @media (max-width: 800px) {
    .guide {
      --s: 4px;
      --rows: 12;
      left: 8px;
    }
    .guide .bubble {
      left: calc(16 * var(--s) + 14px);
      bottom: 0;
      padding: 6px 10px;
      font-size: 12px;
      line-height: 1.3;
    }
  }
</style>
