---
// Single-colour pixel icons from src/icons/pixel-icons.ts. They use currentColor,
// so a link's colour and hover state carry through.
// Decorative: the link text names the action.
import { icons, toPath } from '../icons/pixel-icons';

interface Props {
  name: 'github' | 'email' | 'linkedin';
  size?: number; // CSS pixels per sprite pixel
  class?: string;
}
const { name, size = 2, class: className = '' } = Astro.props;
const rows = icons[name].rows;
---

<svg
  class={`pixel-icon ${className}`}
  width={rows[0].length * size}
  height={rows.length * size}
  viewBox={`0 0 ${rows[0].length} ${rows.length}`}
  shape-rendering="crispEdges"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={toPath(rows)}></path>
</svg>

<style>
  .pixel-icon {
    display: block;
    flex: none;
  }
</style>
