---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
// Alternate sides so the page has a rhythm. On narrow screens the card always comes first.
const flip = index % 2 === 1;
---

<section
  class:list={['showcase', { flip, wide: !!project.data.image }]}
  aria-label={project.data.title}
>
  <div class="card-side">
    <ProjectCard project={project} />
  </div>
  <div class="media-side">
    <ProjectMedia
      title={project.data.title}
      youtube={project.data.youtube}
      sim={project.data.sim}
      image={project.data.image}
    />
  </div>
</section>

<style>
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(40px, 7vw, 96px);
  }
  .flip {
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
  }
  /* Rows with a demo image give the media more room so chart text and labels stay legible. */
  .wide {
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(28px, 3.5vw, 48px);
  }
  .wide.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
  }
  @media (max-width: 1000px) {
    .wide,
    .wide.flip {
      grid-template-columns: minmax(0, 1fr);
    }
    .wide.flip .card-side,
    .wide.flip .media-side {
      order: 0;
    }
  }
  .flip .card-side {
    order: 2;
  }
  .flip .media-side {
    order: 1;
  }
  /* One authored moment: each side settles in as its row scrolls into view.
     The default state is fully visible, so unsupported browsers and reduced-motion
     users see the page as is. The media slides in from its outer edge. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .card-side {
        animation-name: rise;
        animation-fill-mode: both;
      }
      .media-side {
        --from: 48px;
        animation-name: slide-in;
        animation-fill-mode: both;
      }
      .flip .media-side {
        --from: -48px;
      }
      /* Timeline longhands live in their own rules: the minifier would otherwise merge
         them into the animation shorthand, which some browsers reject. */
      .showcase > .card-side {
        animation-timeline: view();
      }
      .showcase > .card-side {
        animation-range: entry 0% entry 55%;
      }
      .showcase > .media-side {
        animation-timeline: view();
      }
      .showcase > .media-side {
        animation-range: entry 8% entry 65%;
      }
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(32px);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(var(--from));
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 800px) {
    .showcase,
    .flip,
    .wide,
    .wide.flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-block: 32px;
    }
    .flip .card-side,
    .flip .media-side {
      order: 0;
    }
    /* Stacked: the media rises like the card instead of sliding sideways. */
    .media-side,
    .flip .media-side {
      --from: 0px;
    }
  }
</style>
