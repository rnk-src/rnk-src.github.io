---
// A pixel crescent moon on a 12x12 grid. Decorative only.
interface Props {
  size?: number; // CSS pixels per sprite pixel
  class?: string;
}
const { size = 8, class: className = '' } = Astro.props;

const rows = [
  '....llls....',
  '..llllls....',
  '.llls.......',
  '.lcls.......',
  'llls........',
  'lcls........',
  'llls........',
  'llcs........',
  '.llls.......',
  '.llls.......',
  '..llllls....',
  '....llls....',
];
const fills: Record<string, string> = {
  l: 'var(--moon-light)',
  c: 'var(--moon-crater)',
  s: 'var(--moon-shade)',
};

const rects: { x: number; y: number; w: number; fill: string }[] = [];
rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const c = row[x];
    let w = 1;
    while (x + w < row.length && row[x + w] === c) w++;
    if (c !== '.') rects.push({ x, y, w, fill: fills[c] });
    x += w;
  }
});
---

<svg
  class={`moon ${className}`}
  width={rows[0].length * size}
  height={rows.length * size}
  viewBox={`0 0 ${rows[0].length} ${rows.length}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {rects.map((r) => (
    <rect x={r.x} y={r.y} width={r.w} height={1} fill={r.fill} />
  ))}
</svg>

<style>
  .moon {
    display: block;
  }
</style>
