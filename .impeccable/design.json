  "narrative": {
    "northStar": "The Quiet Night Sky",
    "overview": "A project list set under a night sky. The projects lead and the theme stays at the edges: sparse stars, a pixel moon, muted planets down the margins, a stepped hill strip and a few baby penguins. Pixel art is an accent and never the page.",
    "keyCharacteristics": [
      "Near-black navy ground with deep violet panels and one lavender accent.",
      "Pixel display face for headings only.",
      "Notched pixel corners instead of rounded ones. No shadows.",
      "Decorative sprites are always aria-hidden.",
      "One authored motion moment per row."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Lavender is the only accent. The penguin's amber beak is the only warm colour on the page.",
        "section": "colors"
      },
      {
        "name": "The Margin Rule",
        "body": "Colour and decoration live at the edges and in the sky. Text panels stay quiet.",
        "section": "colors"
      },
      {
        "name": "The Pixel Face Rule",
        "body": "Silkscreen is for headings only.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep pixel art to accents: sky, margins, borders and a few penguins.",
      "Do respect prefers-reduced-motion.",
      "Do keep every text colour at WCAG AA contrast."
    ],
    "donts": [
      "Don't add glows, gradients, gradient text or offset block shadows.",
      "Don't use rounded corners. Use the notch.",
      "Don't set body text in the pixel face.",
      "Don't add a second accent colour.",
      "Don't invent project facts."
    ]
  }
