      "html": "<article class=\"ds-card\"><div class=\"ds-card-inner\"><h3>Background Cleaner</h3><p>Jul 2023 \u2013 Dec 2023</p><a href=\"#\">View Background Cleaner on GitHub</a></div></article>",
